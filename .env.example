# Скопируйте этот файл в .env и заполните пустые строки. Подробности — в README.md.
# В .env.example секретные значения всегда остаются пустыми.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=                      # публичный HTTPS-адрес Mini App (для теста — адрес из cloudflared)
ADMIN_CHAT_ID=                   # необязательно: копии книг и отзывов; число покажет команда /id в боте

# --- Какие сервисы использовать ---
TEXT_PROVIDER=mock               # mock | openai | gemini
IMAGE_PROVIDER=mock              # mock | openai | cloudflare

# --- OpenAI (платно, текст и картинки) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_EFFORT=medium        # режим размышления текста: low | medium | high (high на кыргызском может не уложиться в таймаут)
WRITER_MODE=simple               # simple: один запрос писателя (рекомендуется) | legacy: старый конвейер
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium      # low | medium | high

# --- Gemini (бесплатный тариф, только тест с вымышленными данными) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Вычитка кыргызского текста (необязательно) ---
TEXT_PROOF_MODEL=                # отдельная модель для вычитки кыргызского; пусто — работает основная модель текста

# --- Cloudflare Workers AI (бесплатные картинки для теста) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Режим и лимиты ---
DEV_MODE=0                       # 1 = открывать Mini App в обычном браузере, только для теста
MAX_BOOKS_PER_USER_PER_DAY=3
KEEP_FILES_DAYS=7

# --- Книга ---
TEXT_OVERLAY_MODE=auto           # как лежит текст на картинке в PDF: auto | fade | plate | plain
#   auto  — сам выбирает под фон: спокойный светлый фон = текст со светлым свечением, иначе картинка плавно тает в кремово-белый (fade)
#   fade  — всегда плавное «таяние» картинки в белый к краю книги, текст тёмный сверху
#   plate — всегда мягкая подложка под текстом (кремовая или тёмная)
#   plain — никогда ничего не накладывать на картинку: только свечение или тень за буквами

# --- Необязательные настройки (можно не трогать) ---
# HOST=127.0.0.1                 # на сервере поставьте 0.0.0.0
# PORT=8080
# DATA_DIR=data                  # где хранятся база и книги
# MAX_PARALLEL_GENERATIONS=3     # сколько книг пишется одновременно на весь сервис
# IMAGE_CONCURRENCY=3            # сколько картинок рисуется одновременно (лимиты OpenAI)
# MOCK_DELAY_SECONDS=1.2         # пауза «заглушек», чтобы на экране ожидания был виден прогресс
