# Скопируйте этот файл в .env и заполните пустые строки. Подробности — в README.md.
# В .env.example секретные значения всегда остаются пустыми.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=                      # публичный HTTPS-адрес Mini App (для теста — адрес из cloudflared)
ADMIN_CHAT_ID=                   # необязательно: копии книг и отзывов; число покажет команда /id в боте

# --- Какие сервисы использовать ---
TEXT_PROVIDER=mock               # mock | openai | gemini
IMAGE_PROVIDER=mock              # mock | openai | cloudflare

# --- OpenAI (платно, текст и картинки) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium      # low | medium | high

# --- Gemini (бесплатный тариф, только тест с вымышленными данными) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Cloudflare Workers AI (бесплатные картинки для теста) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Режим и лимиты ---
DEV_MODE=0                       # 1 = открывать Mini App в обычном браузере, только для теста
MAX_BOOKS_PER_USER_PER_DAY=3
KEEP_FILES_DAYS=7

# --- Необязательные настройки (можно не трогать) ---
# HOST=127.0.0.1                 # на сервере поставьте 0.0.0.0
# PORT=8080
# DATA_DIR=data                  # где хранятся база и книги
# MAX_PARALLEL_GENERATIONS=3     # сколько книг пишется одновременно на весь сервис
# IMAGE_CONCURRENCY=3            # сколько картинок рисуется одновременно (лимиты OpenAI)
# MOCK_DELAY_SECONDS=1.2         # пауза «заглушек», чтобы на экране ожидания был виден прогресс
